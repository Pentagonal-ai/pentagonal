# Pentagonal Telegram bot — environment
# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# From @BotFather on Telegram: /newbot -> copy the HTTP API token
TELEGRAM_BOT_TOKEN=

# Anthropic API key (server-side only — this process is the only thing that ever sees it)
ANTHROPIC_API_KEY=

# Optional: override the Pentagonal API base used for token scans (defaults to production)
# PENTAGONAL_BASE_URL=https://www.pentagonal.ai

# Sentinel alert poller (Chunk 3) — set both to deliver alerts from the Supabase `alerts` table.
# Same values as the Pentagonal app's .env.local. SUPABASE_URL accepts the NEXT_PUBLIC_SUPABASE_URL value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: hard-code the alerts chat instead of using /alertshere
# ALERTS_CHAT_ID=
